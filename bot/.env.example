# ─── Setup bot ─── copy to bot/.env (never commit it) ─── see docs/BOT.md

# paper (default, simulated) · testnet (Binance Spot Testnet) · live (real money)
MODE=paper
# Live also needs this exact phrase — a second, deliberate switch:
# LIVE_CONFIRM=I_UNDERSTAND_THIS_TRADES_REAL_MONEY

# Binance API key: Spot trading ONLY, withdrawals OFF, restricted to the server's IP.
# Testnet keys come from https://testnet.binance.vision (separate from live keys).
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Setups on this account: v1 (capitulation) and/or a (breakout), e.g. SETUPS=v1,a (docs/ROADMAP.md §4.10)
SETUPS=v1

# Setup v1
STOCH=either                 # either · 5,3,3 · 14,3,3
RISK_PER_TRADE=0.01          # equity lost at the −15% stop (0.01 → a 6.7% position). Start live at 0.0025.
MAX_RISK_PER_BAR=0           # v1.2: cap on the v1 risk taken on one bar, e.g. 0.05 (0 = off, v1.1)
V1_FIRST_DOT_ONLY=0          # §4.12: skip a second green dot of the same drop (1 = on)
MAX_OPEN_POSITIONS=15
MIN_BREADTH=10               # v1.1: trade a bar only when ≥ this many pairs signal at once

# Setup A (only with SETUPS containing a)
RISK_PER_TRADE_A=0.005       # equity lost at the 8×ATR stop (~20% away → a ~2.5% position)
MAX_OPEN_POSITIONS_A=15
A_MAX_RS=                    # §4.12: only coins whose 30-day return trails BTC's by more than this, e.g. -0.1 (empty = off)
A_SPIKE_TIGHTEN=0            # §4.16: tighten the trail to 4×ATR after a tall up-bar (≥ 3×ATR) in profit (1 = on)

# Both setups
MAX_POSITION_FRACTION=0.1    # cap per position, of equity (one position per pair across setups)
MIN_LIQUIDITY_30D=1000000    # trailing 30-day average daily quote volume, USDT
DAILY_LOSS_LIMIT=0.05        # no new entries for the rest of the UTC day after −5%
MIN_SIZE_MAX_RISK=0          # small accounts: below the exchange minimum, take the smallest valid size if it risks ≤ this (e.g. 0.015)

# Paper simulation
PAPER_START_EQUITY=10000
FEE_RATE=0.001               # per side
SLIPPAGE=0.0005              # per side

# Telegram (optional): bot token from @BotFather, your chat id (see docs/BOT.md)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# API for the web app's Bot panel. With a token it listens on all interfaces; without, localhost only.
API_PORT=8787
API_TOKEN=

DB_PATH=bot/data/bot.sqlite
